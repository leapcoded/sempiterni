---
import "../styles/global.css";
import HeaderSearch from "../components/HeaderSearch.astro";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: string;
}

const {
  title = "Sempiterni Codex",
  description = "An interactive dictionary of the Sempiterni universe.",
  canonicalPath,
  ogType = "website",
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, "") || "https://sempiterni.lilpossum.xyz";
const canonicalUrl = canonicalPath ? new URL(canonicalPath, site).href : Astro.url.href;
const ogImage = new URL("/og-card.svg", site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="Sempiterni Codex" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="scanlines" aria-hidden="true"></div>
    <div class="glow glow-a" aria-hidden="true"></div>
    <div class="glow glow-b" aria-hidden="true"></div>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">
          <span class="brand-mark">◈</span>
          <span>
            <strong>Sempiterni</strong>
            <small>Interstellar Codex</small>
          </span>
        </a>
        <HeaderSearch />
        <nav class="site-nav">
          <a href="/">Home</a>
          <a href="/browse/">A–Z</a>
          <a href="/tags/">Tags</a>
          <a href="/search/">Search</a>
          <a href="https://lilpossum.xyz">lilpossum.xyz</a>
        </nav>
      </div>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>Reader-facing worldbuilding for the Sempiterni series. Entries may be updated as the canon evolves.</p>
      </div>
    </footer>
  </body>
</html>
