---
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryNav from "../components/CategoryNav.astro";
import EntryCard from "../components/EntryCard.astro";
import SearchPanel from "../components/SearchPanel.astro";
import { getCategoryTree, categoryUrl, sectionUrl, manifest } from "../lib/entries";
import { getReadingPaths } from "../lib/reading-orders";

const tree = getCategoryTree();
const readingPaths = getReadingPaths();
---

<BaseLayout title="Sempiterni Codex">
  <section class="hero container">
    <p class="eyebrow">Interactive Dictionary</p>
    <h1>Navigate the Sempiterni universe.</h1>
    <p>
      Browse by category, follow cross-links between articles, and search {manifest.entryCount} codex entries
      covering factions, systems, characters, and glossary terms.
    </p>
    <SearchPanel />
  </section>

  <section class="container wiki-layout">
    <CategoryNav />

    <div class="wiki-main">
      <section class="category-grid">
        {tree.map((category) => (
          <article class="panel category-card">
            <div class="category-card-header">
              <div>
                <p class="eyebrow">{category.entryCount} entries</p>
                <h2><a href={categoryUrl(category)}>{category.name}</a></h2>
                <p>{category.description}</p>
              </div>
            </div>
            <ul class="section-list">
              {category.sections.map((section) => (
                <li>
                  <a href={sectionUrl(category, section)}>
                    <span>{section.name}</span>
                    <span class="count">{section.entries.length}</span>
                  </a>
                </li>
              ))}
            </ul>
            <p class="card-footer-link">
              <a href={categoryUrl(category)}>View all {category.name} →</a>
            </p>
          </article>
        ))}
      </section>

      <section class="panel recent-block">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Reading paths</p>
            <h2>Curated trails</h2>
          </div>
        </div>
        <div class="reading-path-grid">
          {readingPaths.map((path) => (
            <article class="reading-path-card">
              <h3>{path.title}</h3>
              <p>{path.description}</p>
              <ol class="reading-path-list">
                {path.entries.map((item) => (
                  <li><a href={`/entry/${item.slug}/`}>{item.title}</a></li>
                ))}
              </ol>
            </article>
          ))}
        </div>
      </section>

      <section class="panel recent-block">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Quick start</p>
            <h2>Popular starting points</h2>
          </div>
          <a href="/browse/">Full A–Z index</a>
        </div>
        <div class="entry-list compact-list">
          {["the-convergence-aetheris", "arbour-branches-overview", "aran-sunderwood", "glossary-aetheris", "the-crash", "world-systems"]
            .map((slug) => manifest.entries.find((entry) => entry.slug === slug))
            .filter(Boolean)
            .map((entry) => <EntryCard entry={entry!} />)}
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
