---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import EntrySidebar from "../../components/EntrySidebar.astro";
import EntryStubBanner from "../../components/EntryStubBanner.astro";
import {
  getEntries,
  getEntry,
  getEntryContent,
  getAdjacentEntries,
  getStubInfo,
  extractToc,
  renderMarkdown,
  categoryUrl,
  sectionUrl,
  tagUrl,
} from "../../lib/entries";
import fs from "node:fs";
import path from "node:path";

export function getStaticPaths() {
  return getEntries().map((entry) => ({
    params: { slug: entry.slug },
  }));
}

const { slug } = Astro.params;
const entry = getEntry(slug!);

if (!entry) {
  throw new Error(`Missing entry for slug: ${slug}`);
}

const contentPath = path.join(process.cwd(), "src/content/entries", `${slug}.md`);
const raw = fs.existsSync(contentPath) ? fs.readFileSync(contentPath, "utf8") : getEntryContent(slug!);
const toc = extractToc(raw);
const html = renderMarkdown(raw, slug!);
const { prev, next } = getAdjacentEntries(entry);
const stub = getStubInfo(entry, raw);
---

<BaseLayout title={`${entry.title} — Sempiterni Codex`} description={entry.excerpt}>
  <article class="entry-page container">
    <Breadcrumbs
      crumbs={[
        { label: entry.category, href: categoryUrl(entry.category) },
        { label: entry.section, href: sectionUrl(entry.category, entry.section) },
        { label: entry.title },
      ]}
    />

    <div class="entry-layout">
      <div class="entry-main">
        <header class="entry-header">
          <p class="eyebrow">{entry.category} / {entry.section}</p>
          <h1>{entry.title}</h1>
          {entry.excerpt ? <p class="entry-lead">{entry.excerpt}</p> : null}
          <div class="tag-bar">
            {entry.tags.map((tag) => (
              <a class="tag-chip link-chip" href={tagUrl(tag)}>{tag}</a>
            ))}
          </div>
        </header>

        {stub ? <EntryStubBanner stub={stub} /> : null}

        <div class="panel entry-body" set:html={html} />

        <nav class="entry-nav panel" aria-label="Entry navigation">
          {prev ? (
            <a class="entry-nav-link prev" href={`/entry/${prev.slug}/`}>
              <span>Previous</span>
              <strong>{prev.title}</strong>
            </a>
          ) : <span />}
          {next ? (
            <a class="entry-nav-link next" href={`/entry/${next.slug}/`}>
              <span>Next</span>
              <strong>{next.title}</strong>
            </a>
          ) : <span />}
        </nav>
      </div>

      <EntrySidebar entry={entry} toc={toc} />
    </div>
  </article>
</BaseLayout>
