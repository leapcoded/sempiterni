---
import type { EntryMeta } from "../lib/entries";

interface Props {
  entry: EntryMeta;
  showCategory?: boolean;
}

const { entry, showCategory = true } = Astro.props;
---

<a class="entry-card" href={`/entry/${entry.slug}/`}>
  {showCategory ? (
    <div class="entry-meta">
      <span>{entry.category}</span>
      <span>•</span>
      <span>{entry.section}</span>
    </div>
  ) : null}
  <h2>{entry.title}</h2>
  {entry.excerpt ? <p>{entry.excerpt}</p> : null}
</a>
