---
import searchIndex from "../data/search-index.json";

type SearchRecord = {
  slug: string;
  title: string;
  excerpt: string;
  category: string;
  section: string;
  tags: string[];
  entryType?: string;
  body: string;
};

const records = searchIndex as SearchRecord[];
---

<div class="header-search" data-header-search>
  <label class="sr-only" for="header-search-input">Search the codex</label>
  <input
    id="header-search-input"
    class="header-search-input"
    type="search"
    placeholder="Search…"
    autocomplete="off"
    enterkeyhint="search"
  />
  <div class="header-search-results panel" id="header-search-results" hidden></div>
</div>

<script define:vars={{ records }}>
  const root = document.querySelector("[data-header-search]");
  const input = document.getElementById("header-search-input");
  const results = document.getElementById("header-search-results");

  function scoreEntry(entry, terms) {
    let score = 0;
    const title = entry.title.toLowerCase();
    const haystack = `${entry.title} ${entry.excerpt} ${entry.tags.join(" ")} ${entry.category} ${entry.section} ${entry.body}`.toLowerCase();

    for (const term of terms) {
      if (title.includes(term)) score += 12;
      if (entry.tags.some((tag) => tag.includes(term))) score += 6;
      if (entry.excerpt.toLowerCase().includes(term)) score += 4;
      if (haystack.includes(term)) score += 1;
    }

    return score;
  }

  function renderResults(query) {
    const normalized = query.trim().toLowerCase();
    if (!normalized) {
      results.hidden = true;
      results.innerHTML = "";
      return;
    }

    const terms = normalized.split(/\s+/).filter(Boolean);
    const matches = records
      .map((entry) => ({ entry, score: scoreEntry(entry, terms) }))
      .filter((item) => item.score > 0)
      .sort((a, b) => b.score - a.score || a.entry.title.localeCompare(b.entry.title))
      .slice(0, 10);

    if (!matches.length) {
      results.hidden = false;
      results.innerHTML = `<p class="search-empty">No entries match “${query}”.</p>`;
      return;
    }

    results.hidden = false;
    results.innerHTML = matches
      .map(
        ({ entry }) => `
          <a class="search-result" href="/entry/${entry.slug}/">
            <strong>${entry.title}</strong>
            <span>${entry.category} · ${entry.section}</span>
            <p>${entry.excerpt}</p>
          </a>
        `,
      )
      .join("");
  }

  input?.addEventListener("input", () => renderResults(input.value));
  input?.addEventListener("focus", () => {
    if (input.value.trim()) renderResults(input.value);
  });
  input?.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      results.hidden = true;
      input.blur();
    }
  });
  document.addEventListener("click", (event) => {
    if (!root?.contains(event.target)) results.hidden = true;
  });
</script>
